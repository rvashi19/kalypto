# KALYPTO API — example environment (no real secrets). Copy to .env and fill in.

# ── Core ──
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/export_assurance
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change-me-in-production-min-32-chars
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# ── AI providers (at least one enables compliance AI extraction) ──
AI_PROVIDER=auto
OPENAI_API_KEY=
GROQ_API_KEY=

# ── Country Compliance Checker (retrieval + review) ──
COMPLIANCE_ALLOWED_DOMAINS=
COMPLIANCE_MAX_PAGES_PER_JOB=10
COMPLIANCE_MAX_PDF_MB=15
COMPLIANCE_FETCH_TIMEOUT_SECONDS=30
COMPLIANCE_MAX_RETRIES=3
COMPLIANCE_STORAGE_BACKEND=local
COMPLIANCE_STORAGE_PATH=./.compliance_storage

# Shared secret so an external cron (GitHub Actions) can call
# POST /api/v1/compliance/refresh-due without a full admin login.
ADMIN_CRON_TOKEN=

# ── AI Document Verifier ──
DOCUMENT_VERIFIER_MAX_FILE_MB=20
DOCUMENT_VERIFIER_ALLOWED_TYPES=pdf,xlsx,csv,jpg,jpeg,png
