{
  "name": "export-incentive-assurance-platform",
  "private": true,
  "packageManager": "pnpm@9.12.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"apps/web/**/*.{ts,tsx,css,html,json}\" \"packages/*/src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"apps/web/**/*.{ts,tsx,css,html,json}\" \"packages/*/src/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "knip": "^6.43.0",
    "prettier": "^3.9.10",
    "turbo": "^2.0.14",
    "typescript": "^5.7.3"
  }
}
