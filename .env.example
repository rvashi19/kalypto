POSTGRES_DB=export_assurance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
ENVIRONMENT=development
JWT_SECRET_KEY=change-me-in-production
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/export_assurance
FRONTEND_URL=http://localhost:5173
CORS_ALLOW_ORIGIN_REGEX=https://.*\.(onrender\.com|vercel\.app)
VITE_API_BASE_URL=http://localhost:8000/api/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
XAI_API_KEY=
XAI_MODEL=grok-4.3
XAI_BASE_URL=https://api.x.ai/v1
UPLOAD_DIR=/tmp/kalypto_uploads
SEED_DEMO_DATA=true
COMPLIANCE_STORE_BACKEND=postgres
COMPLIANCE_SCRAPER_PROVIDER=http
COMPLIANCE_ALLOW_PRIVATE_SCRAPE=false
COMPLIANCE_SCRAPER_USER_AGENT=KalyptoComplianceBot/0.1 (+https://kalypto.local; review-only)
COMPLIANCE_REFRESH_INTERVAL_DAYS=3
MONGODB_URL=
MONGODB_DATABASE=kalypto
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
BRIGHT_DATA_API_KEY=

# Free-tier production notes:
# - Render API: set ENVIRONMENT=production, DATABASE_URL from Neon, REDIS_URL from Upstash,
#   FRONTEND_URL to the Vercel production URL, and a generated 32+ char JWT_SECRET_KEY.
# - Neon URLs may be postgresql://...; the API normalizes them to postgresql+psycopg://...
# - Upstash Redis may use redis://... or rediss://...
# - Vercel web: set VITE_API_BASE_URL=https://<render-api-host>/api/v1.
# - Keep COMPLIANCE_STORE_BACKEND=postgres unless MongoDB is intentionally provisioned.
