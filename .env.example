POSTGRES_DB=export_assurance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
ENVIRONMENT=development
JWT_SECRET=change-me-in-production
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_EXPIRES_MINUTES=30
JWT_REFRESH_EXPIRES_DAYS=30
AUTH_COOKIE_NAME=exportpilotai_session
AUTH_REFRESH_COOKIE_NAME=exportpilotai_refresh
AUTH_COOKIE_SAMESITE=lax
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/export_assurance
FRONTEND_URL=http://localhost:5173
CORS_ALLOW_ORIGIN_REGEX=https://.*\.(onrender\.com|vercel\.app)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_GOOGLE_CLIENT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=KALYPTO
ENABLE_GOOGLE_LOGIN=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
XAI_API_KEY=
XAI_MODEL=grok-4.3
XAI_BASE_URL=https://api.x.ai/v1
UPLOAD_DIR=/tmp/kalypto_uploads
SEED_DEMO_DATA=true
COMPLIANCE_STORE_BACKEND=postgres
COMPLIANCE_SCRAPER_PROVIDER=http
COMPLIANCE_ALLOW_PRIVATE_SCRAPE=false
COMPLIANCE_SCRAPER_USER_AGENT=KalyptoComplianceBot/0.1 (+https://kalypto.local; review-only)
COMPLIANCE_REFRESH_INTERVAL_DAYS=3
COMPLIANCE_ALLOWED_DOMAINS=
COMPLIANCE_MAX_PAGES_PER_JOB=10
COMPLIANCE_MAX_PDF_MB=15
COMPLIANCE_FETCH_TIMEOUT_SECONDS=30
COMPLIANCE_MAX_RETRIES=3
COMPLIANCE_STORAGE_BACKEND=local
COMPLIANCE_STORAGE_PATH=/tmp/kalypto_compliance_storage
ADMIN_CRON_TOKEN=
MONGODB_URL=
MONGODB_DATABASE=kalypto
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
BRIGHT_DATA_API_KEY=

# Free-tier production notes:
# - Render API: set ENVIRONMENT=production, DATABASE_URL from Neon, REDIS_URL from Upstash,
#   FRONTEND_URL to the Vercel production URL, AUTH_COOKIE_SAMESITE=none when the
#   frontend is on Vercel and API is on Render, and a generated 32+ char JWT_SECRET.
# - Set SMTP_* before enabling production registration; OTPs are never logged in production.
# - Set GOOGLE_CLIENT_ID and ENABLE_GOOGLE_LOGIN=true on the API, and VITE_GOOGLE_CLIENT_ID on Vercel.
# - Neon URLs may be postgresql://...; the API normalizes them to postgresql+psycopg://...
# - Upstash Redis may use redis://... or rediss://...
# - Vercel web: set VITE_API_BASE_URL=https://<render-api-host>/api/v1.
# - Keep COMPLIANCE_STORE_BACKEND=postgres unless MongoDB is intentionally provisioned.
